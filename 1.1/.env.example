# ============================================================================
# 复制本文件为 .env 后填写真实值：  cp .env.example .env
# .env 已在 .gitignore 里，**永远不要提交**
# ============================================================================

# ── Web 服务监听 ────────────────────────────────────────────────────────────
# 本机管理页面直接访问，HOST 仅支持 127.0.0.1 / localhost / ::1。
PORT=8000
HOST=127.0.0.1

# 登录态临期/掉线预警邮件开关（默认 on）。本机调试没有真实登录态时可设 off，
# 避免体检与手动运行误发告警邮件；看门狗卡死告警不受此开关影响。
# SESSION_WARN_EMAIL_ENABLED=on

# ── 其它 ────────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 可选：发送间隔兜底（秒） ────────────────────────────────────────────────
# 实际间隔以管理后台里配置的发送间隔为准，这两个值只在配置缺失时兜底。
# SEND_INTERVAL_MIN=1.0
# SEND_INTERVAL_MAX=4.0

# ── 可选：浏览器预热与常驻 ─────────────────────────────────────────────────
# 冷启动 Chromium 约 20 秒。默认发送前 60 秒预启动，发完保留 600 秒供复用。
# KEEP_PREWARMED_SECONDS=600
#
# 常驻模式：浏览器永不主动关闭，冷启动彻底消除。适合长期挂机的服务器。
# KEEP_BROWSER_ALWAYS=true
#
# 预启动实例最大空闲秒数；0 = 永不过期。常驻模式下默认 0，否则默认 900。
# BROWSER_MAX_IDLE_SECONDS=900
